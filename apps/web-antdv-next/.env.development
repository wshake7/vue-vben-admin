# 端口号
VITE_PORT=5999

VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# Vite 代理：/api/* 按前缀分流到 java-admin(4080) 或 backend-mock-template(4000)
# createProxy 会去掉前缀，所以 target 需带完整路径段，如 /api/auth/ → http://localhost:4080/api/auth/X
# 顺序即匹配优先级：java 已实现的前缀在前，其余回退 mock
# java: auth / user / altcha / encrypt / menu(动态菜单) / system/user|role|menu
# encrypt 公钥须与 java 鉴权链路同钥，否则 Encrypt 开时登录会因密钥不一致失败
VITE_PROXY='[["/api/auth/", "http://localhost:4080/api/auth/"], ["/api/user/", "http://localhost:4080/api/user/"], ["/api/altcha/", "http://localhost:4080/api/altcha/"], ["/api/encrypt/", "http://localhost:4080/api/encrypt/"], ["/api/menu/", "http://localhost:4080/api/menu/"], ["/api/system/user/", "http://localhost:4080/api/system/user/"], ["/api/system/role/", "http://localhost:4080/api/system/role/"], ["/api/system/menu/", "http://localhost:4080/api/system/menu/"], ["/api/", "http://localhost:4000/api/"]]'

# 纯Mock
# VITE_PROXY='[["/api/", "http://localhost:4000/api/"]]'

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
# 当前关闭：复用外层 monorepo 已在 4000 端口独立启动的 backend-mock-template
VITE_NITRO_MOCK=false

# Nitro Mock 包路径，$/xxx 解析为 <外层 monorepo 根>/xxx
# 例如 $/apps/backend-mock-template → <仓库根>/apps/backend-mock-template
VITE_NITRO_MOCK_SERVER_PACKAGE=$/apps/backend-mock-template

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 当前前端平台标识（与 backend mock 的 ?platform= 过滤对齐；缺省视为 general）
VITE_APP_PLATFORM=vue-admin

# 菜单模式：frontend=前端静态路由，backend=后端动态菜单
VITE_ACCESS_MODE=backend

# 请求安全开关（与后端 app.security.* / mock SECURITY_* 同步；缺省全开）
VITE_SECURITY_TIMESTAMP_ENABLED=true
VITE_SECURITY_ENCRYPT_ENABLED=false
VITE_SECURITY_NONCE_ENABLED=true
VITE_SECURITY_SIGN_ENABLED=true
VITE_SECURITY_LANGUAGE_ENABLED=true
